<% layout('layout', { pageTitle: 'Our Story', page: 'story', viewer, csrfToken }) -%>

<style>
  #story-svg {
    transition: opacity 2s ease-in-out;
  }
  .svg-loading {
    opacity: 0;
  }
</style>

<div class="max-w-4xl mx-auto px-4 pt-40 pb-12">
  <h1 class="text-4xl font-bold text-center mb-8 font-mellira">Our Story</h1>
  <img id="story-svg" src="/public/story.svg" alt="Our Story" class="w-full h-auto rounded-lg shadow-md mb-8 svg-loading">
</div>

<script>
  const storySvg = document.getElementById('story-svg');
  if (storySvg.complete) {
    storySvg.classList.remove('svg-loading');
  } else {
    storySvg.addEventListener('load', () => {
      storySvg.classList.remove('svg-loading');
    });
  }
</script>
