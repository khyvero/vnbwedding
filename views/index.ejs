<% layout('layout', { fullWidth: true, pageTitle: "Veronica & Bishoy's Wedding" }) -%>

<style>
  .animated-section {
    opacity: 0;
    transition: opacity 1s ease-out 0.6s, transform 1s ease-out 0.6s;
  }
  .fade-in {
    opacity: 0;
    transform: translateY(20px);
  }
  .fade-in-left {
    opacity: 0;
    transform: translateX(-30px);
  }
  .fade-in-right {
    opacity: 0;
    transform: translateX(30px);
  }
  .fade-in-up {
    opacity: 0;
    transform: translateY(30px);
  }
  .visible {
    opacity: 1;
    transform: none;
  }
</style>

<!-- Full-bleed hero -->
<section class="relative w-screen h-[100svh] ml-[calc(50%-50vw)] mr-[calc(50%-50vw)] overflow-hidden isolate animated-section" data-animation="fade-in">

  <!-- Background photo -->
  <img
    src="/visual_assets/public/index/index_photo02.png"
    alt="Veronica & Bishoy"
    class="absolute inset-0 w-full h-full object-cover object-[50%_35%] z-0 select-none pointer-events-none"
    draggable="false"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Gradient overlays -->
  <div class="absolute inset-0 z-10 pointer-events-none bg-gradient-to-b from-[#B9D6E6]/40 via-[#B9D6E6]/20 to-transparent"></div>
  <div class="absolute inset-0 z-10 pointer-events-none bg-gradient-to-b from-black/100 via-black/30 to-transparent"></div>

  <!-- Hero content -->
  <div class="relative z-20 flex h-full items-center justify-center pointer-events-none">
    <div class="text-center text-white px-6 transform -translate-y-16 md:-translate-y-20 pointer-events-auto">
      <h1 class="drop-shadow-sm">
        <img src="/visual_assets/public/title_names_white.svg" alt="Veronica & Bishoy" class="w-full max-w-md md:max-w-lg mx-auto" />
      </h1>

      <p class="mt-4 text-lg opacity-90">
        Friday, 3 October 2025 · Berlin
      </p>

      <p class="mt-6 max-w-3xl mx-auto text-base md:text-lg opacity-90">
        <% if (viewer && viewer.name) { %>
          <span class="block mb-1">Dear <span class="font-semibold"><%= viewer.name %></span>,</span>
        <% } %>
        We’re so excited to celebrate with you. Join us for a day filled with love, laughter,
        and cherished moments as we start our next chapter.
      </p>

      <% if (viewer) { %>
        <p class="mt-4 text-base opacity-90">
          Just a friendly reminder: the deadline to RSVP is <strong>September 10th, 2025</strong>.
        </p>
      <% } %>

      <!-- Countdown (simple white text, smaller) -->
      <div class="mt-8 flex items-end justify-center gap-6 text-white">
        <div class="text-center">
          <div id="cd-days" class="text-3xl font-semibold tabular-nums">--</div>
          <div class="text-[10px] uppercase tracking-wide opacity-90">Days</div>
        </div>
        <div class="text-center">
          <div id="cd-hours" class="text-3xl font-semibold tabular-nums">--</div>
          <div class="text-[10px] uppercase tracking-wide opacity-90">Hours</div>
        </div>
        <div class="text-center">
          <div id="cd-mins" class="text-3xl font-semibold tabular-nums">--</div>
          <div class="text-[10px] uppercase tracking-wide opacity-90">Minutes</div>
        </div>
        <div class="text-center">
          <div id="cd-secs" class="text-3xl font-semibold tabular-nums">--</div>
          <div class="text-[10px] uppercase tracking-wide opacity-90">Seconds</div>
        </div>
      </div>

      <p id="cd-label" class="mt-3 text-xs opacity-90 text-white">Counting down to the celebration…</p>

      <div class="mt-6 flex justify-center items-center gap-x-4">
        <button
          type="button"
          class="rsvp-button inline-flex items-center rounded-full bg-[#1E2A44] text-white px-4 py-2 shadow <%= rsvpLocked ? 'opacity-50 cursor-not-allowed' : 'hover:bg-[#6595BF]' %>"
          data-logged-in="<%= !!viewer %>"
          data-target-url="/rsvp"
          <%= rsvpLocked ? 'disabled' : '' %>
        >
          <%= rsvpLocked ? 'RSVP Closed' : 'RSVP' %>
        </button>

        <% if (viewer && viewer.group === 'bridesmaids') { %>
        <a
          href="/bridesmaids"
          class="inline-flex items-center rounded-full bg-white/20 text-white px-4 py-2 text-sm shadow hover:bg-[#6595BF]"
        >
          Bridesmaids Info
        </a>
        <% } %>
        <% if (viewer && viewer.group === 'groomsmen') { %>
        <a
          href="/groomsmen"
          class="inline-flex items-center rounded-full bg-white/20 text-white px-4 py-2 text-sm shadow hover:bg-[#6595BF]"
        >
          Groomsmen Info
        </a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- Content anchors -->
<section id="locations" class="max-w-6xl mx-auto px-4 py-24">
  <h2 class="text-3xl mb-12 text-center font-mellira">Locations</h2>
  <div class="grid md:grid-cols-2 gap-12 max-w-4xl mx-auto">
    <!-- Location 1: Ceremony -->
    <div class="text-center animated-section" data-animation="fade-in-left">
      <h3 class="text-2xl mb-1">Ceremony</h3>
      <p class="font-semibold">Schloss Schönhausen</p>
      <p class="opacity-80">Tschaikowskistraße 1, 13156 Berlin</p>
      <a href="https://www.google.com/maps/search/?api=1&query=Schloss+Schönhausen%2C+Tschaikowskistraße+1%2C+13156+Berlin"
         target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 mt-4 bg-white border border-stone-300 px-4 py-2 rounded-full hover:bg-stone-100 transition-colors text-sm">
        <img src="/visual_assets/public/gmaps.svg" alt="" class="h-5 w-5" />
        Show location
      </a>
    </div>
    <!-- Location 2: Reception -->
    <div class="text-center animated-section" data-animation="fade-in-right">
      <h3 class="text-2xl mb-1">Reception</h3>
      <p class="font-semibold">Ermelerhaus</p>
      <p class="opacity-80">Märkisches Ufer 10, 10179 Berlin</p>
      <a href="https://www.google.com/maps/search/?api=1&query=Ermelerhaus%2C+Märkisches+Ufer+10%2C+10179+Berlin"
         target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 mt-4 bg-white border border-stone-300 px-4 py-2 rounded-full hover:bg-stone-100 transition-colors text-sm">
        <img src="/visual_assets/public/gmaps.svg" alt="" class="h-5 w-5" />
        Show location
      </a>
    </div>
  </div>
</section>

<section id="timeline" class="bg-stone-50/60 border-y py-24">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl mb-12 text-center font-mellira">Order of the Day</h2>
    <div class="flex flex-col items-center">
      <img src="/visual_assets/public/orderofday/OrderOfTheDay00.svg" alt="Timeline event 1" class="w-full max-w-md mx-auto animated-section" data-animation="fade-in-up">
      <img src="/visual_assets/public/orderofday/OrderOfTheDay01.svg" alt="Timeline event 2" class="w-full max-w-md mx-auto -mt-10 animated-section" data-animation="fade-in-up">
      <img src="/visual_assets/public/orderofday/OrderOfTheDay02.svg" alt="Timeline event 3" class="w-full max-w-md mx-auto -mt-10 animated-section" data-animation="fade-in-up">
      <img src="/visual_assets/public/orderofday/OrderOfTheDay03.svg" alt="Timeline event 4" class="w-full max-w-md mx-auto -mt-10 animated-section" data-animation="fade-in-up">
      <img src="/visual_assets/public/orderofday/OrderOfTheDay04.svg" alt="Timeline event 5" class="w-full max-w-md mx-auto -mt-10 animated-section" data-animation="fade-in-up">
      <img src="/visual_assets/public/orderofday/OrderOfTheDay05.svg" alt="Timeline event 6" class="w-full max-w-md mx-auto -mt-10 animated-section" data-animation="fade-in-up">
      <img src="/visual_assets/public/orderofday/OrderOfTheDay06.svg" alt="Timeline event 7" class="w-full max-w-md mx-auto -mt-10 animated-section" data-animation="fade-in-up">
      <img src="/visual_assets/public/orderofday/OrderOfTheDay07.svg" alt="Timeline event 8" class="w-full max-w-md mx-auto -mt-10 animated-section" data-animation="fade-in-up">
    </div>
  </div>
</section>

<section id="registry" class="max-w-6xl mx-auto px-4 py-24 animated-section" data-animation="fade-in">
  <h2 class="text-3xl mb-12 text-center font-mellira">Registry</h2>
  <div class="text-center max-w-2xl mx-auto text-[#1E2A44] opacity-90">
    <p class="text-lg">
      Your presence at our wedding is the greatest gift we could ask for. We are so excited to celebrate with you!
    </p>
    <p class="mt-4 text-lg">
      For those who have expressed an interest, we have set up a honeymoon fund. Contributions are deeply appreciated and will help us create cherished memories on our first adventure as a married couple. If you would like to contribute, you can do so via PayPal or a bank transfer.
    </p>
    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <div class="flex flex-col items-center text-center h-full">
        <h3 class="text-xl font-semibold mb-2">PayPal</h3>
        <img src="/visual_assets/public/paypalQR.jpeg" alt="PayPal QR Code" class="mx-auto w-48 h-48 object-contain">
        <a href="https://paypal.me/bhawad" target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-sm text-blue-600 hover:underline">Or use this link: paypal.me/bhawad</a>
      </div>
      <div class="flex flex-col items-center text-center h-full">
        <h3 class="text-xl font-semibold mb-2">Bank Transfer</h3>
        <img src="/visual_assets/public/bankQRcode.jpeg" alt="Bank QR Code" class="mx-auto w-48 h-48 object-contain">
        <div class="mt-4 text-sm invisible">placeholder</div>
      </div>
    </div>
  </div>
</section>

<section id="faqs" class="bg-stone-50/60 border-y py-24 animated-section" data-animation="fade-in-up">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-3xl mb-12 text-center font-mellira">FAQs</h2>
    <div class="space-y-4">
      <div class="accordion-item">
        <button class="accordion-header">
          <span>I haven't received my email invitation or RSVP confirmation. What should I do?</span>
          <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-content">
          <p>We're sorry for the trouble! Please try the following steps:</p>
          <ol>
            <li><strong>Check your Spam or Junk Folder:</strong> Sometimes, automated emails can be accidentally filtered. Please look for an email from bishoy.veronica@gmail.com.</li>
            <li><strong>Confirm Your Email Address:</strong> Please double-check with the couple to ensure they have your correct email address on file.</li>
            <li><strong>Contact the Couple:</strong> If you'vetried the steps above and still can't find the email, please reach out to the couple directly so they can assist you.</li>
          </ol>
        </div>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">
          <span>When is the RSVP deadline?</span>
          <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-content">
          <p>Please make sure to RSVP by 10th of September so we can provide our vendors with an accurate headcount. If we don't receive your RSVP by the date, we will have to mark you as "not attending."</p>
        </div>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">
          <span>I have a food allergy or dietary restriction. What should I do?</span>
          <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-content">
          <p>We definitely want to make sure you can enjoy the meal! When you RSVP, there will be a section to note any dietary restrictions or allergies you may have. We will do our best to accommodate you.</p>
        </div>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">
          <span>Are children welcome to attend?</span>
          <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-content">
          <p>While we love your little ones, we have made the difficult decision to limit attendance to those named on the invitation, unless you have coordinated otherwise with us directly. We hope you can still join us to celebrate and enjoy a relaxing evening.</p>
        </div>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">
          <span>What is the dress code for your wedding?</span>
          <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-content">
          <p>We'd love for you to be comfortable and ready to celebrate! The dress code is semi-formal or dressy casual. For men, this could mean a suit or a sport coat and slacks. For women, a cocktail dress, a stylish jumpsuit, or a dressy skirt and top would be perfect.</p>
        </div>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">
          <span>What are the parking options at the venues?</span>
          <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-content">
          <p>Parking availability differs for the ceremony and the reception.</p>
          <ul>
            <li><strong>For the Ceremony:</strong> Free parking is available on the streets surrounding the palace.</li>
            <li><strong>For the Reception (at Ermelerhaus):</strong> Street parking is limited but still possible to find. If you know you will need a parking space, please contact us directly, and we will do our best to help coordinate one for you.</li>
          </ul>
        </div>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">
          <span>How do I get from the ceremony to the reception?</span>
          <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-content">
          <p>The two venues are located at:</p>
          <ul>
            <li><strong>Ceremony:</strong> Schloss Schönhausen, Tschaikowskistraße 1, 13156 Berlin</li>
            <li><strong>Reception:</strong> Ermelerhaus, Märkisches Ufer 10, 10179 Berlin</li>
          </ul>
          <p>Berlin has an excellent public transportation system, which is a great way to travel between the venues. The journey typically takes about 30-40 minutes. A simple route is to take the U-Bahn (subway) line U2 to the Märkisches Museum station, which is just a short walk from Ermelerhaus. Ride-sharing services like Uber and Bolt are also readily available.</p>
          <p>For guests who would prefer pre-arranged travel, we are happy to help coordinate transportation from the ceremony to the reception. If you need this service, please be sure to check the corresponding box when you fill out your RSVP.</p>
        </div>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">
          <span>What will the weather be like in Berlin on October 3rd?</span>
          <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-content">
          <p>While it's too early for a precise forecast, early October in Berlin is the heart of autumn. Historically, you can expect average daytime temperatures around 14°C (57°F), with cooler evenings that can drop to about 7°C (45°F).</p>
          <p>The weather can be a lovely mix of crisp, sunny days and cooler, overcast skies with a chance of rain. We recommend bringing layers—like a sweater or a light jacket—and it might be wise to pack a small umbrella, just in case. Please be sure to check a reliable weather forecast closer to the wedding date for the most accurate information.</p>
        </div>
      </div>
      <% if (viewer) { %>
        <div class="accordion-item">
          <button class="accordion-header">
            <span>Have a Question?</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="accordion-content">
            <form id="contactForm" method="post" action="/contact" class="p-4">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <textarea name="message" rows="4" class="w-full rounded-lg border border-stone-300 p-2 resize-none" placeholder="Your message..." maxlength="300"></textarea>
              <div class="mt-2">
                <p id="contactStatus" class="text-sm mb-2 min-h-[1.25rem]"></p>
                <div class="flex justify-end">
                  <button type="submit" class="px-4 py-2 rounded-lg bg-[#1E2A44] text-white hover:bg-[#2a3b5a]">Send</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<script>
  // --- Animations ---
  document.addEventListener("DOMContentLoaded", () => {
    const animatedSections = document.querySelectorAll('.animated-section');

    animatedSections.forEach(section => {
        if(section.dataset.animation) {
            section.classList.add(section.dataset.animation);
        }
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        } else {
          entry.target.classList.remove('visible');
        }
      });
    }, { threshold: 0.1 });

    animatedSections.forEach(section => {
      observer.observe(section);
    });
  });

  // --- Countdown (Berlin time) ---
  (function(){
    const target = new Date('2025-10-03T12:00:00+02:00'); // Europe/Berlin
    const d = document.getElementById('cd-days');
    const h = document.getElementById('cd-hours');
    const m = document.getElementById('cd-mins');
    const s = document.getElementById('cd-secs');
    const lbl = document.getElementById('cd-label');
    const pad = n => String(n).padStart(2,'0');

    function update(){
      const now = new Date();
      let diff = target - now;

      if (diff <= 0) {
        d.textContent = '00'; h.textContent = '00'; m.textContent = '00'; s.textContent = '00';
        const bNow = new Date(now.toLocaleString('en-GB', { timeZone: 'Europe/Berlin' }));
        const bTar = new Date(target.toLocaleString('en-GB', { timeZone: 'Europe/Berlin' }));
        const same = bNow.getFullYear()===bTar.getFullYear() && bNow.getMonth()===bTar.getMonth() && bNow.getDate()===bTar.getDate();
        lbl.textContent = same ? "It's today! 🎉" : "Happily ever after has begun 💍";
        return;
      }

      const sec = Math.floor(diff/1000);
      const dd  = Math.floor(sec/86400);
      const hh  = Math.floor((sec % 86400) / 3600);
      const mm  = Math.floor((sec % 3600) / 60);
      const ss  = sec % 60;

      d.textContent = String(dd);
      h.textContent = pad(hh);
      m.textContent = pad(mm);
      s.textContent = pad(ss);
      lbl.textContent = "Counting down to the celebration…";
    }

    (function tick(){
      update();
      const now = Date.now();
      setTimeout(tick, 1000 - (now % 1000));
    })();
  })();

  // --- Contact Form ---
  const contactForm = document.getElementById('contactForm');
  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const statusEl = document.getElementById('contactStatus');
      const button = contactForm.querySelector('button[type="submit"]');
      const accordionContent = contactForm.closest('.accordion-content');

      statusEl.textContent = 'Sending...';
      statusEl.classList.remove('text-red-600', 'text-green-600');
      if (accordionContent) accordionContent.style.maxHeight = accordionContent.scrollHeight + 'px';
      button.disabled = true;

      const fd = new FormData(contactForm);
      const body = new URLSearchParams(fd);

      try {
        const res = await fetch('/contact', {
          method: 'POST',
          body,
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'csrf-token': fd.get('_csrf') || ''
          }
        });

        const result = await res.json();

        if (!res.ok) {
          statusEl.textContent = result.error || 'An error occurred.';
          statusEl.classList.add('text-red-600');
        } else {
          statusEl.textContent = result.message;
          statusEl.classList.add('text-green-600');
          contactForm.reset();
        }
      } catch (err) {
        statusEl.textContent = 'A network error occurred.';
        statusEl.classList.add('text-red-600');
      } finally {
        button.disabled = false;
        if (accordionContent) {
          setTimeout(() => {
            accordionContent.style.maxHeight = accordionContent.scrollHeight + 'px';
          }, 200);
        }
      }
    });
  }
</script>